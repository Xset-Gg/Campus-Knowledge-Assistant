# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=ckadmin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=campus_knowledge
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ckadmin:change_me@db:5432/campus_knowledge

# ---------------------------------------------------------------------------
# Auth / JWT
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Supported: "openai", "anthropic"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Thinking depth / token spend for the answer call: low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TOKENS=2048
# Upper bound on retrieved context sent to the model, enforced by token counting
MAX_CONTEXT_TOKENS=24000

# ---------------------------------------------------------------------------
# Embeddings & reranking
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------
HYBRID_SEMANTIC_WEIGHT=0.6
HYBRID_KEYWORD_WEIGHT=0.4
RRF_K=60
RETRIEVAL_TOP_K=25
RERANK_TOP_K=5
ANSWER_CONFIDENCE_THRESHOLD=0.35
CURRENT_ACADEMIC_YEAR=2026

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ENABLE_TRACING=false

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
